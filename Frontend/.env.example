# Copy this file to .env and fill in your Cloudinary credentials.
# Get these from https://cloudinary.com → Settings → Upload → Upload presets

# Your Cloudinary cloud name (shown on the dashboard)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# An UNSIGNED upload preset (Settings → Upload → Add upload preset → Signing Mode: Unsigned)
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
