{
  "name": "vehicle-auction-backend",
  "version": "0.1.0",
  "description": "Vehicle auction backend (Node.js + Express, layered architecture)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node scripts/migrate.js",
    "seed:admins": "node scripts/seed-admins.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:demo:no-clear": "node scripts/seed-demo.js --no-clear",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watchAll --forceExit",
    "test:report": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --forceExit --verbose --json --outputFile=test-results/results.json"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "joi": "^17.11.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  }
}
